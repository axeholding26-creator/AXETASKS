# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. http://localhost:3000 in dev)
APP_URL="http://localhost:3000"

# JWT_SECRET: A strong random string used to sign session tokens. 
# Generate one using: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="your_strong_jwt_secret_here"

# PostgreSQL Database Configuration
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD="your_database_password"
SQL_DB_NAME="axetask"
