# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (e.g. https://your-app.vercel.app in prod,
# http://localhost:3000 in dev). Used for the CORS allowlist.
APP_URL="http://localhost:3000"

# JWT_SECRET: A strong random string used to sign session tokens. Required in production —
# the server refuses to start without it. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="your_strong_jwt_secret_here"

# ADMIN_EMAIL / ADMIN_PASSWORD / ADMIN_NAME: the single owner account is created
# automatically on first boot if it doesn't exist yet, using these values. Leave
# unset to skip auto-creation. Never commit real values here — set them in your
# local .env (gitignored) and in your hosting provider's environment variables.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="choose_a_strong_password"
ADMIN_NAME="Admin"

# --- PostgreSQL Database Configuration ---
# Option A (recommended for Vercel / any managed Postgres like Neon, Supabase, Vercel Postgres):
# set a single connection string. Most providers require SSL — set SQL_SSL=true with them.
# DATABASE_URL="postgres://user:password@host:5432/dbname"
# SQL_SSL="true"

# Option B (local development against a plain local/self-hosted Postgres):
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD="your_database_password"
SQL_DB_NAME="axetask"
